# https://127.0.0.1:8443 for docker-compose.local.yml. Clients send no SNI for an IP address and the connection
# arrives on the container's own IP, so default_sni tells Caddy which certificate to present.
{
	default_sni 127.0.0.1
	auto_https disable_redirects
}

https://127.0.0.1:8443 {
	tls internal
	reverse_proxy app:8080
}
